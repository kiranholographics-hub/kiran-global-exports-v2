# Copy to .env.local. Must be prefixed VITE_ to be readable in the browser.
VITE_API_URL=http://localhost:4000

# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank in dev/local —
# analytics.js no-ops entirely when this isn't set, so no test traffic
# ever gets sent to the real GA4 property.
VITE_GA_MEASUREMENT_ID=
