# Copy this file to .env and fill in real values.
# .env is gitignored and is NOT written by any automated tool — edit it by hand.

# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API (comma-separate multiple origins)
CORS_ORIGIN=http://localhost:3000

# How many reverse-proxy hops to trust for detecting the real visitor IP
# (used for visit-country lookup and rate limiting). Leave as 1 for a
# normal single-proxy hosting setup (Render, Railway, Nginx, etc.). Set to
# 0 only if this API is ever exposed directly to the internet with no
# proxy in front of it.
TRUST_PROXY=1

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kiran-global-exports?retryWrites=true&w=majority

# Optional: outbound notification email for new enquiries (nodemailer), leave
# blank to skip email sending — enquiries are always saved to MongoDB regardless.
# Also used for the AI-chat pre-chat approval email (see APPROVAL_SECRET below).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=export@kiranglobal-exports.com

# OpenAI AI website chat (keep this key on the backend only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# AI chat pre-chat approval gate — required for POST /api/chat/lead and its
# approve/decline email links.
# This backend's own public URL, used to build the approve/decline links
# inside the notification email. Keep as localhost while developing.
APP_BASE_URL=http://localhost:4000
# Any long random string — signs the approve/decline links so they can't be
# guessed or forged. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_SECRET=

# Optional: protects GET /api/enquiries and GET /api/chat/lead (stopgap
# listing endpoints, pre admin-panel). Leave blank to keep them disabled
# (they 404 without a matching x-admin-key header).
ADMIN_API_KEY=

# Visitor notification digest — texts a summary of new site visits every
# VISIT_DIGEST_INTERVAL_MINUTES (not one SMS per visit, to avoid spam).
# Leave the interval unset for the 20-minute default.
VISIT_DIGEST_INTERVAL_MINUTES=20

# SMS delivery via MSG91 (see backend/src/sms.js). Sending SMS to Indian
# numbers legally requires a DLT-registered transactional template — see
# https://msg91.com for account + DLT registration.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=
# Must match the DLT-approved template text exactly (only {{count}},
# {{country}}, {{page}} may vary). Example to register with MSG91:
#   {{count}} new visit(s) on your website, mostly from {{country}}, viewing {{page}}.
MSG91_MESSAGE_TEMPLATE=
# Owner's phone number to notify, country code + number, digits only.
NOTIFY_PHONE_NUMBER=919928911181
