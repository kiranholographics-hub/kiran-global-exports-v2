# Copy this file to .env and fill in real values.
# .env is gitignored and is NOT written by any automated tool — edit it by hand.

# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API (comma-separate multiple origins)
CORS_ORIGIN=http://localhost:3000

# How many reverse-proxy hops to trust for detecting the real visitor IP
# (used for visit-country lookup and rate limiting). Leave as 1 for a
# normal single-proxy hosting setup (Render, Railway, Nginx, etc.). Set to
# 0 only if this API is ever exposed directly to the internet with no
# proxy in front of it.
TRUST_PROXY=1

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kiran-global-exports?retryWrites=true&w=majority

# Optional: outbound notification email for new enquiries (nodemailer), leave
# blank to skip email sending — enquiries are always saved to MongoDB regardless.
# Also used for the AI-chat pre-chat approval email (see APPROVAL_SECRET below).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=export@kiranglobal-exports.com

# OpenAI AI website chat (keep this key on the backend only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# AI chat pre-chat approval gate — required for POST /api/chat/lead and its
# approve/decline email links.
# This backend's own public URL, used to build the approve/decline links
# inside the notification email. Keep as localhost while developing.
APP_BASE_URL=http://localhost:4000
# Any long random string — signs the approve/decline links so they can't be
# guessed or forged. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_SECRET=

# Legacy stopgap key for GET /api/enquiries, /api/visits and /api/chat/lead —
# superseded by real login (see JWT_SECRET below). Kept defined for one
# deploy cycle as a rollback safety net; safe to remove once the new
# Authorization: Bearer login path is confirmed working in production.
ADMIN_API_KEY=

# Real admin login (backend/src/auth.js). Any long random string — signs
# login tokens so they can't be guessed or forged. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# One-time use only: set these, run `npm run create-admin` once to create
# the first admin account, then blank them back out.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Visitor notification digest — sends a WhatsApp message summarizing new
# site visits every VISIT_DIGEST_INTERVAL_MINUTES (not one message per
# visit, to avoid spam). Leave the interval unset for the 20-minute default.
VISIT_DIGEST_INTERVAL_MINUTES=20

# WhatsApp delivery via MSG91 (see backend/src/whatsapp.js). Requires the
# "website_visit_alert" template approved under WhatsApp > Manage Templates.
MSG91_AUTH_KEY=
# The WhatsApp Business number connected under WhatsApp > Number, digits
# only with country code (e.g. 919983911181).
MSG91_WHATSAPP_INTEGRATED_NUMBER=
# Owner's number to notify, same digits-only format.
NOTIFY_WHATSAPP_NUMBER=919928911181
