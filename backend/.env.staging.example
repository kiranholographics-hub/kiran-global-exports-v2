# Local staging convention — copy this OVER your backend/.env file whenever
# you're testing changes locally (auth, product-catalogue migration, etc.)
# so you're never pointed at the production database by accident.
#
# Setup (one-time):
#   1. In MongoDB Atlas, create a second database in the SAME free cluster
#      named `kiran-global-exports-staging` (Atlas lets you have as many
#      databases as you want in one free cluster — no new cluster needed).
#   2. Copy this file to backend/.env when you want to test locally:
#        cp backend/.env.staging.example backend/.env
#      then fill in the same secrets you already have in your real .env
#      (SMTP, OPENAI_API_KEY, etc. can be reused — only MONGODB_URI differs).
#   3. Before deploying or touching production data, switch back to your
#      real backend/.env (the one with the production MONGODB_URI).
#
# Rule: never run `npm run seed` or `npm run create-admin` without first
# checking which database MONGODB_URI below actually points at.

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=1

# Same Atlas cluster as production, different database name:
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kiran-global-exports-staging?retryWrites=true&w=majority

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=export@kiranglobal-exports.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

APP_BASE_URL=http://localhost:4000
APPROVAL_SECRET=

ADMIN_API_KEY=

VISIT_DIGEST_INTERVAL_MINUTES=20

MSG91_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
NOTIFY_WHATSAPP_NUMBER=919928911181

# Auth (see Phase 0 plan) — sign requests with this secret while testing.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# One-time use: run `npm run create-admin` once against this staging
# database with these set, then blank them out again.
ADMIN_EMAIL=
ADMIN_PASSWORD=
